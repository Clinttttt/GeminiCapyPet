<Window x:Class="GeminiCapyPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Capy Pet" Width="218" Height="232"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid x:Name="PetSurface" Background="Transparent"
          MouseLeftButtonDown="OnPetMouseDown"
          MouseLeftButtonUp="OnPetMouseUp"
          MouseMove="OnPetMouseMove"
          MouseEnter="OnPetEnter"
          MouseLeave="OnPetLeave"
          MouseRightButtonUp="OnPetRightClick">
        <Image x:Name="PetSprite" Width="214" Height="214"
               VerticalAlignment="Top" HorizontalAlignment="Center"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.88" />
        <Border x:Name="HintPill" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,4" Padding="5" CornerRadius="16" Background="#F01C2639" Opacity="1"
                MouseLeftButtonDown="OnToolbarMouseDown">
            <Border.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/>
                    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EDF1F7"/>
                    <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#405674"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#405674"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AppButton" Click="OnAppButton" AutomationProperties.Name="Toggle selected software">
                    <Image x:Name="SelectedAppIcon" Width="23" Height="23"/>
                </Button>
                <Button Content="☰" Click="OnMenuButton" ToolTip="Capies menu" AutomationProperties.Name="Capies menu"/>
                <Button Content="−" FontSize="20" Click="OnCollapseButton" ToolTip="Collapse Capies to tray" AutomationProperties.Name="Collapse Capies to tray"/>
                <TextBlock x:Name="HintText" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>