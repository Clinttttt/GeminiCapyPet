<Window x:Class="GeminiCapyPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Capy Pet" Width="218" Height="232"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid x:Name="PetSurface" Background="Transparent"
          MouseLeftButtonDown="OnPetMouseDown"
          MouseLeftButtonUp="OnPetMouseUp"
          MouseMove="OnPetMouseMove"
          MouseEnter="OnPetEnter"
          MouseLeave="OnPetLeave"
          MouseRightButtonUp="OnPetRightClick">
        <Image x:Name="PetSprite" Width="214" Height="214"
               VerticalAlignment="Top" HorizontalAlignment="Center"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.88" />
        <Border x:Name="HintPill" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,6" Padding="12,5" CornerRadius="12"
                Background="#E51C2639" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#8CD4A0" Margin="0,0,7,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="HintText" Text="Open Gemini" Foreground="White"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>