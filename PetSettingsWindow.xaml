<Window x:Class="GeminiCapyPet.PetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Capies" Width="420" Height="460" ResizeMode="NoResize"
        Background="#111827" Foreground="#F5F7FB" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#253449"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Customize your Capies" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a pose and resize your floating pet."
                       Foreground="#A4B1C2" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C2939" CornerRadius="14" Margin="0,0,0,14">
            <Grid>
                <Image x:Name="PosePreview" Width="108" Height="108"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        CornerRadius="9" Background="#324458" Padding="7,3" Margin="0,0,10,8">
                    <TextBlock Text="LIVE PREVIEW" FontSize="10" Foreground="#DDE7F1"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="Pose" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="PoseChoice" SelectionChanged="OnPoseChanged">
                <ComboBoxItem Content="Automatic - plays sleep/wake"/>
                <ComboBoxItem Content="Standing"/>
                <ComboBoxItem Content="Sitting"/>
                <ComboBoxItem Content="Lying down"/>
                <ComboBoxItem Content="Sleeping"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                <TextBlock Text="Size" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock x:Name="SizeLabel" Text="220 px" FontSize="13"
                           Foreground="#A6C8FF" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="SizeSlider" Minimum="140" Maximum="360" Value="220"
                    IsSnapToTickEnabled="True" TickFrequency="5"
                    ValueChanged="OnSizeChanged"/>
            <DockPanel Margin="0,3,0,0">
                <TextBlock Text="Smaller" FontSize="11" Foreground="#899BB0" DockPanel.Dock="Left"/>
                <TextBlock Text="Larger" FontSize="11" Foreground="#899BB0" HorizontalAlignment="Right"/>
            </DockPanel>
        </StackPanel>

        <CheckBox Grid.Row="4" x:Name="AutoSleepCheck"
                  Foreground="#E6EBF3" FontSize="13"
                  Content="Automatically sleep after 45 seconds"
                  Checked="OnAutoSleepChanged" Unchecked="OnAutoSleepChanged"
                  Margin="0,5,0,12"/>

        <DockPanel Grid.Row="5" VerticalAlignment="Bottom" LastChildFill="False">
            <Button Content="Reset defaults" Click="OnReset" DockPanel.Dock="Left"/>
            <Button Content="Done" Click="OnDone" DockPanel.Dock="Right"
                    Background="#2563EB" MinWidth="96"/>
        </DockPanel>
    </Grid>
</Window>
